            <column datatype='real' name="share_of_company_pain" ordinal='4' />
            <column datatype='integer' name="stage_order" ordinal='5' />
            <column datatype='integer' name="pain_order" ordinal='6' />
            <column datatype='string' name="stage_label" ordinal='7' />
            <column datatype='string' name="pain_label" ordinal='8' />
          </columns>
        </relation>
      </connection>
      <column caption="증권사" datatype='string' name='[company]' role='dimension' type='nominal' />
      <column caption="journey_stage" datatype='string' name='[journey_stage]' role='dimension' type='nominal' />
      <column caption="pain_type" datatype='string' name='[pain_type]' role='dimension' type='nominal' />
      <column caption="불편 리뷰(건)" datatype='integer' name='[reviews]' role='measure' type='quantitative' />
      <column caption="share_of_company_pain" datatype='real' name='[share_of_company_pain]' role='measure' type='quantitative' />
      <column caption="stage_order" datatype='integer' name='[stage_order]' role='dimension' type='ordinal' />
      <column caption="pain_order" datatype='integer' name='[pain_order]' role='dimension' type='ordinal' />
      <column caption="여정 단계" datatype='string' name='[stage_label]' role='dimension' type='nominal' />
