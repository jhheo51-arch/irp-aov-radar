    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="1 객단가 격차">
      <table>
        <view>
          <datasources>
            <datasource name='federated.irp_t1' />
          </datasources>
          <datasource-dependencies datasource='federated.irp_t1'>
            <column caption="IRP 계약 수(건)" datatype='integer' name='[contracts]' role='measure' type='quantitative' />
            <column-instance column='[contracts]' derivation='Sum' name='[sum:contracts:qk]' pivot='key' type='quantitative' />
            <column caption="계약 1건당 적립금(만 원)" datatype='integer' name='[reserve_per_contract_10k_krw]' role='measure' type='quantitative' />
            <column-instance column='[reserve_per_contract_10k_krw]' derivation='Sum' name='[sum:reserve_per_contract_10k_krw:qk]' pivot='key' type='quantitative' />
            <column caption="한국투자증권" datatype='integer' name='[kis_flag]' role='measure' type='quantitative' />
            <column-instance column='[kis_flag]' derivation='Sum' name='[sum:kis_flag:qk]' pivot='key' type='quantitative' />
            <column caption="적립금(억 원)" datatype='real' name='[reserve_100m_krw]' role='measure' type='quantitative' />
            <column-instance column='[reserve_100m_krw]' derivation='Sum' name='[sum:reserve_100m_krw:qk]' pivot='key' type='quantitative' />
            <column caption="증권사" datatype='string' name='[provider]' role='dimension' type='nominal' />
            <column-instance column='[provider]' derivation='None' name='[none:provider:nk]' pivot='key' type='nominal' />
            <column caption="연도" datatype='integer' name='[year]' role='dimension' type='ordinal' />
            <column-instance column='[year]' derivation='None' name='[none:year:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.irp_t1].[none:year:ok]'>
            <groupfilter function='member' level='[none:year:ok]' member='2025' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.irp_t1].[none:year:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.irp_t1].[sum:kis_flag:qk]' palette='orange_10_0' type='interpolated' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column='[federated.irp_t1].[sum:kis_flag:qk]' />
              <size column='[federated.irp_t1].[sum:reserve_100m_krw:qk]' />
              <text column='[federated.irp_t1].[none:provider:nk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='false' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.irp_t1].[sum:reserve_per_contract_10k_krw:qk]</rows>
        <cols>[federated.irp_t1].[sum:contracts:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="2 불편 히트맵">
      <table>
        <view>
          <datasources>
            <datasource name='federated.irp_t2' />
          </datasources>
          <datasource-dependencies datasource='federated.irp_t2'>
            <column caption="불편 유형" datatype='string' name='[pain_label]' role='dimension' type='nominal' />
            <column-instance column='[pain_label]' derivation='None' name='[none:pain_label:nk]' pivot='key' type='nominal' />
            <column caption="여정 단계" datatype='string' name='[stage_label]' role='dimension' type='nominal' />
            <column-instance column='[stage_label]' derivation='None' name='[none:stage_label:nk]' pivot='key' type='nominal' />
            <column caption="불편 리뷰(건)" datatype='integer' name='[reviews]' role='measure' type='quantitative' />
            <column-instance column='[reviews]' derivation='Sum' name='[sum:reviews:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.irp_t2].[sum:reviews:qk]' palette='orange_10_0' type='interpolated' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Square' />
            <encodings>
              <color column='[federated.irp_t2].[sum:reviews:qk]' />
              <text column='[federated.irp_t2].[sum:reviews:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='false' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.irp_t2].[none:stage_label:nk]</rows>
        <cols>[federated.irp_t2].[none:pain_label:nk]</cols>
      </table>
    </worksheet>
    <worksheet name="3 기회">
      <table>
        <view>
          <datasources>
            <datasource name='federated.irp_t3' />
          </datasources>
          <datasource-dependencies datasource='federated.irp_t3'>
            <column caption="3사 불편 리뷰(건)" datatype='integer' name='[pain_reviews_3co]' role='measure' type='quantitative' />
            <column-instance column='[pain_reviews_3co]' derivation='Sum' name='[sum:pain_reviews_3co:qk]' pivot='key' type='quantitative' />
            <column caption="커머스 방식" datatype='string' name='[lever_label]' role='dimension' type='nominal' />
            <column-instance column='[lever_label]' derivation='None' name='[none:lever_label:nk]' pivot='key' type='nominal' />
            <column caption="비중" datatype='string' name='[share_label]' role='dimension' type='nominal' />
            <column-instance column='[share_label]' derivation='None' name='[none:share_label:nk]' pivot='key' type='nominal' />
            <column caption="의미" datatype='string' name='[meaning]' role='dimension' type='nominal' />
            <column-instance column='[meaning]' derivation='None' name='[none:meaning:nk]' pivot='key' type='nominal' />
            <column caption="고객 요청 예" datatype='string' name='[example_requests]' role='dimension' type='nominal' />
            <column-instance column='[example_requests]' derivation='None' name='[none:example_requests:nk]' pivot='key' type='nominal' />
            <column caption="가장 많은 불편" datatype='string' name='[top_pain_type]' role='dimension' type='nominal' />
            <column-instance column='[top_pain_type]' derivation='None' name='[none:top_pain_type:nk]' pivot='key' type='nominal' />
            <column caption="한국투자증권(건)" datatype='integer' name='[pain_reviews_kis]' role='measure' type='quantitative' />
            <column-instance column='[pain_reviews_kis]' derivation='Sum' name='[sum:pain_reviews_kis:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.irp_t3].[sum:pain_reviews_3co:qk]' palette='orange_10_0' type='interpolated' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.irp_t3].[sum:pain_reviews_3co:qk]' />
              <text column='[federated.irp_t3].[none:share_label:nk]' />
              <lod column='[federated.irp_t3].[none:meaning:nk]' />
              <lod column='[federated.irp_t3].[none:example_requests:nk]' />
              <lod column='[federated.irp_t3].[none:top_pain_type:nk]' />
              <lod column='[federated.irp_t3].[sum:pain_reviews_kis:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='false' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.irp_t3].[none:lever_label:nk]</rows>
        <cols>[federated.irp_t3].[sum:pain_reviews_3co:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="4 관리">
      <table>
        <view>
          <datasources>
            <datasource name='federated.irp_t4' />
          </datasources>
          <datasource-dependencies datasource='federated.irp_t4'>
            <column caption="영역" datatype='string' name='[area]' role='dimension' type='nominal' />
            <column-instance column='[area]' derivation='None' name='[none:area:nk]' pivot='key' type='nominal' />
            <column caption="항목" datatype='string' name='[metric]' role='dimension' type='nominal' />
            <column-instance column='[metric]' derivation='None' name='[none:metric:nk]' pivot='key' type='nominal' />
            <column caption="값" datatype='string' name='[value]' role='dimension' type='nominal' />
            <column-instance column='[value]' derivation='None' name='[none:value:nk]' pivot='key' type='nominal' />
            <column caption="설명" datatype='string' name='[note]' role='dimension' type='nominal' />
            <column-instance column='[note]' derivation='None' name='[none:note:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.irp_t4].[none:value:nk]' />
              <lod column='[federated.irp_t4].[none:note:nk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='false' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([federated.irp_t4].[none:area:nk] / [federated.irp_t4].[none:metric:nk])</rows>
        <cols />
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="IRP 객단가 레이더">
      <style />
      <size maxheight='1000' maxwidth='1200' minheight='1000' minwidth='1200' />
      <zones>
      <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
        <zone h='5000' id='2' type-v2='text' w='100000' x='0' y='0'>
          <formatted-text>
            <run fontsize='20' bold='true'>IRP 객단가 레이더</run>
          </formatted-text>
        </zone>
        <zone h='6000' id='3' type-v2='text' w='100000' x='0' y='5000'>
          <formatted-text>
            <run fontsize='11'>한국투자증권은 IRP 계약 수 1위(47.3만 건)지만 계약 1건당 적립금은 1,572만 원으로 미래에셋증권(3,736만 원)의 42%, 전 업권 평균(1,858만 원)보다 낮습니다. 증권 3사 연금 리뷰의 불편 59%는 가입 이후 단계에 몰려 있습니다.</run>
          </formatted-text>
        </zone>
        <zone h='42000' id='4' name="1 객단가 격차" w='50000' x='0' y='11000' />
        <zone h='42000' id='5' name="2 불편 히트맵" w='50000' x='50000' y='11000' />
        <zone h='42000' id='6' name="3 기회" w='50000' x='0' y='53000' />
        <zone h='42000' id='7' name="4 관리" w='50000' x='50000' y='53000' />
        <zone h='5000' id='8' type-v2='text' w='100000' x='0' y='95000'>
          <formatted-text>
            <run fontsize='9'>출처: 금융감독원 통합연금포털 연금통계(2025년 말), 구글 플레이 공개 리뷰(증권 3사 연금 관련 349건). 화면 1은 IRP 계약 5만 건 이상 증권사(주황: 한국투자증권), 화면 2·3은 3사 합계입니다. 리뷰 원문은 공개하지 않으며, 투자 권유가 아닌 서비스 기획 분석입니다.</run>
          </formatted-text>
        </zone>
      </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows source-height='30'>
    <window class='worksheet' name="1 객단가 격차">
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name="2 불편 히트맵">
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name="3 기회">
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name="4 관리">
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
      </cards>
    </window>
