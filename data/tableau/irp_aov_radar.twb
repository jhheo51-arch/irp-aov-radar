      </connection>
      <column caption="journey_stage" datatype='string' name='[journey_stage]' role='dimension' type='nominal' />
      <column caption="stage_order" datatype='integer' name='[stage_order]' role='dimension' type='ordinal' />
      <column caption="commerce_lever" datatype='string' name='[commerce_lever]' role='dimension' type='nominal' />
      <column caption="의미" datatype='string' name='[meaning]' role='dimension' type='nominal' />
      <column caption="3사 불편 리뷰(건)" datatype='integer' name='[pain_reviews_3co]' role='measure' type='quantitative' />
      <column caption="share_3co" datatype='real' name='[share_3co]' role='measure' type='quantitative' />
      <column caption="한국투자증권(건)" datatype='integer' name='[pain_reviews_kis]' role='measure' type='quantitative' />
      <column caption="가장 많은 불편" datatype='string' name='[top_pain_type]' role='dimension' type='nominal' />
      <column caption="비중" datatype='string' name='[share_label]' role='dimension' type='nominal' />
      <column caption="고객 요청 예" datatype='string' name='[example_requests]' role='dimension' type='nominal' />
      <column caption="커머스 방식" datatype='string' name='[lever_label]' role='dimension' type='nominal' />
    </datasource>
    <datasource caption="t4_quality" inline='true' name='federated.irp_t4' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="t4_quality" name='textscan.irp_t4'>
            <connection class='textscan' directory="C:/STA Track/Claude/irp-aov-radar/data/tableau" filename="t4_quality.csv" password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.irp_t4' name="t4_quality.csv" table='[t4_quality#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='ko_KR' separator=','>
            <column datatype='string' name="area" ordinal='0' />
            <column datatype='string' name="metric" ordinal='1' />
            <column datatype='string' name="value" ordinal='2' />
            <column datatype='string' name="note" ordinal='3' />
          </columns>
        </relation>
      </connection>
      <column caption="영역" datatype='string' name='[area]' role='dimension' type='nominal' />
      <column caption="항목" datatype='string' name='[metric]' role='dimension' type='nominal' />
      <column caption="값" datatype='string' name='[value]' role='dimension' type='nominal' />
