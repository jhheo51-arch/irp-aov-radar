<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2023.1.0 (20231.23.0310.1045)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption="t1_aov_trend" inline='true' name='federated.irp_t1' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="t1_aov_trend" name='textscan.irp_t1'>
            <connection class='textscan' directory="C:/STA Track/Claude/irp-aov-radar/data/tableau" filename="t1_aov_trend.csv" password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.irp_t1' name="t1_aov_trend.csv" table='[t1_aov_trend#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='ko_KR' separator=','>
            <column datatype='string' name="provider" ordinal='0' />
            <column datatype='integer' name="year" ordinal='1' />
            <column datatype='integer' name="contracts" ordinal='2' />
            <column datatype='real' name="reserve_100m_krw" ordinal='3' />
            <column datatype='integer' name="reserve_per_contract_10k_krw" ordinal='4' />
            <column datatype='integer' name="market_avg_per_contract_10k_krw" ordinal='5' />
            <column datatype='string' name="highlight" ordinal='6' />
            <column datatype='integer' name="kis_flag" ordinal='7' />
          </columns>
        </relation>
      </connection>
      <column caption="증권사" datatype='string' name='[provider]' role='dimension' type='nominal' />
      <column caption="연도" datatype='integer' name='[year]' role='dimension' type='ordinal' />
      <column caption="IRP 계약 수(건)" datatype='integer' name='[contracts]' role='measure' type='quantitative' />
      <column caption="적립금(억 원)" datatype='real' name='[reserve_100m_krw]' role='measure' type='quantitative' />
      <column caption="계약 1건당 적립금(만 원)" datatype='integer' name='[reserve_per_contract_10k_krw]' role='measure' type='quantitative' />
      <column caption="전 업권 평균(만 원)" datatype='integer' name='[market_avg_per_contract_10k_krw]' role='measure' type='quantitative' />
      <column caption="구분" datatype='string' name='[highlight]' role='dimension' type='nominal' />
      <column caption="한국투자증권" datatype='integer' name='[kis_flag]' role='measure' type='quantitative' />
    </datasource>
    <datasource caption="t2_heatmap" inline='true' name='federated.irp_t2' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="t2_heatmap" name='textscan.irp_t2'>
            <connection class='textscan' directory="C:/STA Track/Claude/irp-aov-radar/data/tableau" filename="t2_heatmap.csv" password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.irp_t2' name="t2_heatmap.csv" table='[t2_heatmap#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='ko_KR' separator=','>
