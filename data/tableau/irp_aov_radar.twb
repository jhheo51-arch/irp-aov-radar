  <datasources>
    <datasource caption="t1_aov_trend" inline='true' name='federated.irp_t1' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="t1_aov_trend" name='textscan.irp_t1'>
            <connection class='textscan' directory="C:/STA Track/Claude/irp-aov-radar/data/tableau" filename="t1_aov_trend.csv" password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.irp_t1' name="t1_aov_trend.csv" table='[t1_aov_trend#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='ko_KR' separator=','>
            <column datatype='string' name="provider" ordinal='0' />
            <column datatype='integer' name="year" ordinal='1' />
            <column datatype='integer' name="contracts" ordinal='2' />
            <column datatype='real' name="reserve_100m_krw" ordinal='3' />
            <column datatype='integer' name="reserve_per_contract_10k_krw" ordinal='4' />
            <column datatype='integer' name="market_avg_per_contract_10k_krw" ordinal='5' />
            <column datatype='string' name="highlight" ordinal='6' />
          </columns>
        </relation>
      </connection>
      <column datatype='string' name='[provider]' role='dimension' type='nominal' />
      <column datatype='integer' name='[year]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[contracts]' role='measure' type='quantitative' />
      <column datatype='real' name='[reserve_100m_krw]' role='measure' type='quantitative' />
      <column datatype='integer' name='[reserve_per_contract_10k_krw]' role='measure' type='quantitative' />
      <column datatype='integer' name='[market_avg_per_contract_10k_krw]' role='measure' type='quantitative' />
      <column datatype='string' name='[highlight]' role='dimension' type='nominal' />
    </datasource>
    <datasource caption="t2_heatmap" inline='true' name='federated.irp_t2' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="t2_heatmap" name='textscan.irp_t2'>
            <connection class='textscan' directory="C:/STA Track/Claude/irp-aov-radar/data/tableau" filename="t2_heatmap.csv" password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.irp_t2' name="t2_heatmap.csv" table='[t2_heatmap#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='ko_KR' separator=','>
            <column datatype='string' name="company" ordinal='0' />
            <column datatype='string' name="journey_stage" ordinal='1' />
            <column datatype='string' name="pain_type" ordinal='2' />
            <column datatype='integer' name="reviews" ordinal='3' />
            <column datatype='real' name="share_of_company_pain" ordinal='4' />
            <column datatype='integer' name="stage_order" ordinal='5' />
            <column datatype='integer' name="pain_order" ordinal='6' />
            <column datatype='string' name="stage_label" ordinal='7' />
            <column datatype='string' name="pain_label" ordinal='8' />
          </columns>
        </relation>
      </connection>
      <column datatype='string' name='[company]' role='dimension' type='nominal' />
      <column datatype='string' name='[journey_stage]' role='dimension' type='nominal' />
      <column datatype='string' name='[pain_type]' role='dimension' type='nominal' />
      <column datatype='integer' name='[reviews]' role='measure' type='quantitative' />
      <column datatype='real' name='[share_of_company_pain]' role='measure' type='quantitative' />
      <column datatype='integer' name='[stage_order]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[pain_order]' role='dimension' type='ordinal' />
      <column datatype='string' name='[stage_label]' role='dimension' type='nominal' />
      <column datatype='string' name='[pain_label]' role='dimension' type='nominal' />
    </datasource>
    <datasource caption="t3_opportunities" inline='true' name='federated.irp_t3' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption="t3_opportunities" name='textscan.irp_t3'>
            <connection class='textscan' directory="C:/STA Track/Claude/irp-aov-radar/data/tableau" filename="t3_opportunities.csv" password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.irp_t3' name="t3_opportunities.csv" table='[t3_opportunities#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='ko_KR' separator=','>
            <column datatype='string' name="journey_stage" ordinal='0' />
            <column datatype='integer' name="stage_order" ordinal='1' />
            <column datatype='string' name="commerce_lever" ordinal='2' />
            <column datatype='string' name="meaning" ordinal='3' />
            <column datatype='integer' name="pain_reviews_3co" ordinal='4' />
            <column datatype='real' name="share_3co" ordinal='5' />
            <column datatype='integer' name="pain_reviews_kis" ordinal='6' />
            <column datatype='string' name="top_pain_type" ordinal='7' />
            <column datatype='string' name="example_requests" ordinal='8' />
            <column datatype='string' name="lever_label" ordinal='9' />
          </columns>
        </relation>
